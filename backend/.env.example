# Copy this file to backend/.env and fill in real values.
# NEVER commit backend/.env — see ../.gitignore.

# --- Database ---
# Pooled connection (used by the running app; Supabase: use the "Transaction" pooler URI, port 6543).
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/skill_navigator
# Direct (non-pooled) connection, required for Alembic migrations (Supabase: port 5432, "Session"/direct URI).
# If unset, migrations fall back to DATABASE_URL.
DIRECT_DATABASE_URL=

# --- Embeddings (RAG) ---
# No embedding model is wired up yet anywhere in this repo (see docs/DATABASE_IMPLEMENTATION_PLAN.md Section 8).
# These two are PROVISIONAL placeholders so document_chunks.embedding has a concrete column type to migrate to.
# Changing EMBEDDING_DIMENSION after data exists requires a new Alembic migration (ALTER COLUMN ... TYPE vector(n)) —
# it is NOT safe to just edit this value once chunks/embeddings exist.
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768

# --- App ---
APP_ENV=local
CORS_ORIGINS=http://localhost:3000

# --- Bhashini Multilingual / Voice Integration (Phase 6.3) ---
# NOTE: Credentials are intentionally pending. Application runs safely with BHASHINI_ENABLED=false.
# When credentials are provided by the project team, fill these in and set BHASHINI_ENABLED=true.
BHASHINI_ENABLED=false
BHASHINI_USER_ID=
BHASHINI_ULCA_API_KEY=
BHASHINI_INFERENCE_API_KEY=
BHASHINI_PIPELINE_ID=
BHASHINI_CONFIG_URL=https://meity-auth.ulcacontrib.org/ulca/apis/v0/model/getModelsPipeline
BHASHINI_INFERENCE_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline
BHASHINI_TIMEOUT_SECONDS=30
